# ==========================================
# SAHVION BACKEND ENVIRONMENT CONFIGURATION
# ==========================================

# Database Configuration (PostgreSQL)
# Format: postgresql://username:password@hostname:port/database_name
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sahvion_db

# Security & CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Production-safe email provider configuration.
# Recommended fallback when you do not own a custom domain: Gmail SMTP.
EMAIL_PROVIDER=smtp
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_EMAIL=sahvion26@gmail.com
CONTACT_PHONE=+91 8148063975

# Gmail SMTP configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_gmail_address@gmail.com
SMTP_PASSWORD=your_16_character_gmail_app_password
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Server Environment
ENVIRONMENT=development
